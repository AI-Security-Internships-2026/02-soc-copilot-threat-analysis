# Copy to .env and fill in real values. Never commit .env itself.

# Required — the LLM triage node (src/agent/nodes.py) and the deepteam
# red-team eval (experiments/deepteam_redteam_eval.py) both call Groq.
# No OpenAI key is required anywhere in this project.
GROQ_API_KEY=your-groq-api-key-here

# Optional — deepteam sends anonymous usage telemetry by default.
# Set to YES to disable it for a controlled research eval.
# DEEPTEAM_TELEMETRY_OPT_OUT=YES
