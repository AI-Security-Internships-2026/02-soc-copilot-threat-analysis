.venv/
venv/
env/
.env
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata

# Datasets and large files (use DVC or document sources in datasets/README.md)
datasets/**/*.csv
datasets/**/*.json
datasets/**/*.parquet
datasets/**/*.h5
datasets/**/*.hdf5
datasets/**/*.pkl
